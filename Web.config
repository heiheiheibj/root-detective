<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <!-- 生产环境关掉 debug：debug=true 会拖慢 ASP.NET 即时编译，并保留调试符号 -->
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <!-- 源码一律按 UTF-8 读，避免服务器(GBK 代码页)把中文注释/字符串解成乱码导致编译错误 -->
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
  </system.web>
  <system.webServer>
    <!-- 打开静态/动态压缩：前端主包约 1.3MB 目前是原样传输，开启后 gzip 可降到约 257KB。
         需要服务器已安装 IIS 的“静态内容压缩 / 动态内容压缩”功能；未安装时此节无副作用。 -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
  </system.webServer>
</configuration>
